// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=wr_1776562783461337442 @name=Nautilus Not Floating
window-rule {
    match app-id="^org.gnome.Nautilus$"
}

// @id=wr_1776564353288927634 @name=PIP Floating
window-rule {
    match app-id="^Picture in picture$"
    open-floating true
}

// @id=wr_1787677552344232452 @name=brave-origin
window-rule {
    match app-id="brave-origin"
    open-maximized true
}

// @id=wr_1787700474287682032 @name=vlc full screen
window-rule {
    match app-id="flatpak run org.videolan.VLC"
    open-maximized true
}
